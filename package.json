{
  "name": "vui-vc-next",
  "version": "0.13.36",
  "description": "Mobile web UI components based on Vue 3 and Vite 7",
  "keywords": [
    "vite",
    "vite7",
    "vitepress",
    "vue",
    "vue-components",
    "vue-composition-api",
    "vue-ui",
    "vue3",
    "vue3-components",
    "vue3-ui",
    "vue3-vite",
    "vue3-vite-ui",
    "vue3-vite-vitepress",
    "vue3-vite-vitepress-ui",
    "vui"
  ],
  "homepage": "https://github.com/v-poc/vui-vc-next/blob/dev/README.md",
  "bugs": {
    "url": "https://github.com/v-poc/vui-vc-next/issues"
  },
  "license": "MIT",
  "author": "Niko Ni",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v-poc/vui-vc-next.git"
  },
  "files": [
    "dist/style.css",
    "dist/vui-vc-next.es.js",
    "dist/vui-vc-next.umd.js",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "main": "dist/vui-vc-next.umd.js",
  "module": "dist/vui-vc-next.es.js",
  "exports": {
    ".": {
      "import": "./dist/vui-vc-next.es.js",
      "require": "./dist/vui-vc-next.umd.js"
    },
    "./css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "dev-docs": "cd docs && vitepress",
    "build": "vite build --config lib/vite.config.js",
    "build-demo": "vite build",
    "build-docs": "cd docs && vitepress build",
    "serve": "vite preview",
    "serve-build": "vite build && cd ./dist && vite",
    "start": "vite"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "postcss-pxtorem": "^6.1.0",
    "sass": "1.77.6",
    "vite": "^7.3.1",
    "vitepress": "^1.6.4",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "browserslist": [
    "iOS >= 8",
    "Android > 4.0"
  ],
  "engines": {
    "node": "^18.0.0 || >=20.0.0",
    "pnpm": ">= 10"
  },
  "packageManager": "pnpm@10.33.0"
}
